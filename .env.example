# Copy to .env and fill in real values. .env itself must never be committed.

POSTGRES_DB=minisoc
POSTGRES_USER=minisoc
POSTGRES_PASSWORD=changeme_local_dev_only

# Used by platform to build its DB connection string
DATABASE_URL=postgresql+psycopg://minisoc:changeme_local_dev_only@db:5432/minisoc

# Explicit reminder, not a real security control:
# MVP API has no auth (documented shortcut, LLD §3.3). Do not expose port 8000
# beyond localhost/lab network.
